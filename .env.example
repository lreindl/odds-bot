# Copy to .env and fill in. Never commit .env.

# TypeSafe console → API keys
TYPESAFE_API_KEY=
# Pin a version (e.g. jev-1.13.0) once thresholds are tuned; jev-latest moves with releases.
JEV_MODEL=jev-latest

# X developer console → your app → Keys and tokens (OAuth 1.0a, Read and Write, generated
# while signed in as the bot account)
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=

# Tuning
MIN_CONFIDENCE=0.4
MIN_FITS=0.5
MIN_OUTCOME_FITS=0.7
MAX_REPLIES_PER_RUN=10
REPLY_WHEN_NOT_FOUND=true
INDEX_MAX_AGE_HOURS=6
